    </div>
    <select id="brand-filter">
      <option value="">All makers</option>
    </select>
    <span class="result-count" id="result-count"></span>
  </div>
</div>

<main class="wrap" id="gallery-root"></main>

<div class="empty-state is-hidden" id="empty-state">
  <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
  <p>No pipes match that search</p>
  <span>Try a different brand or stamp number</span>
</div>

<footer>08 Pipes &mdash; an ongoing estate pipe catalogue</footer>

