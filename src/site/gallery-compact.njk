---
permalink: /gallery-compact/
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pipe Gallery — 08 Pipes</title>
<meta name="description" content="A catalogue of every estate pipe in the collection, grouped by maker.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#0d1a1a;
    --paper-deep:#142626;
    --ink:#e3e8e7;
    --ink-soft:#a9b8b6;
    --briar:hsl(178, 78%, 55%);
    --briar-deep:hsl(181, 70%, 42%);
    --brass:#9fc3ce;
    --sage:#7f9a9c;
    --line:rgba(210,225,222,0.12);
    --card:#182e2e;
    --shadow:0 1px 2px rgba(0,0,0,0.25), 0 6px 16px rgba(0,0,0,0.30);
    --mono:"JetBrains Mono", ui-monospace, SFMono-Regular, "Roboto Mono", Menlo, Consolas, monospace;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}

  body{
    margin:0;
    background:
      radial-gradient(1200px 600px at 10% -10%, rgba(63,217,205,0.07), transparent 60%),
      radial-gradient(900px 500px at 100% 0%, rgba(63,217,205,0.05), transparent 55%),
      var(--paper);
    color:var(--ink);
    font-family:"Inter", system-ui, sans-serif;
    -webkit-font-smoothing:antialiased;
  }

  a{color:inherit;}

  /* ---------- Header ---------- */
  .masthead{
    padding:64px 24px 40px;
    text-align:center;
    border-bottom:1px solid var(--line);
    position:relative;
  }
  .masthead::after{
    content:"";
    position:absolute;
    left:50%;
    bottom:-1px;
    transform:translateX(-50%);
    width:120px;
    height:3px;
    background:var(--brass);
    border-radius:2px;
  }
  .eyebrow{
    font-family:var(--mono);
    font-size:12px;
    letter-spacing:0.18em;
    text-transform:uppercase;
    color:var(--briar);
    margin:0 0 14px;
  }
  h1.title{
    font-family:"Inter", sans-serif;
    font-weight:600;
    font-size:clamp(34px, 5vw, 56px);
    line-height:1.05;
    margin:0 0 14px;
    letter-spacing:-0.01em;
  }
  .subtitle{
    max-width:560px;
    margin:0 auto;
    color:var(--ink-soft);
    font-size:16px;
    line-height:1.55;
  }
  .stats-row{
    display:flex;
    gap:28px;
    justify-content:center;
    margin-top:28px;
    flex-wrap:wrap;
  }
  .stat{
    font-family:var(--mono);
    font-size:13px;
    color:var(--ink-soft);
  }
  .stat b{
    color:var(--ink);
    font-size:15px;
  }

  /* ---------- Search / filter bar ---------- */
  .index-bar{
    position:sticky;
    top:0;
    z-index:20;
    background:rgba(13,26,26,0.88);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line);
    padding:14px 24px;
  }
  .index-inner{
    max-width:1120px;
    margin:0 auto;
    display:flex;
    gap:14px;
    align-items:center;
    flex-wrap:wrap;
  }
  .search-tab{
    flex:1 1 240px;
    position:relative;
    min-width:200px;
  }
  .search-tab input{
    width:100%;
    padding:10px 14px 10px 36px;
    border:1px solid var(--line);
    border-radius:10px;
    background:var(--card);
    font-family:"Inter", sans-serif;
    font-size:14px;
    color:var(--ink);
    outline:none;
    transition:border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .search-tab input:focus{
    border-color:var(--briar);
    box-shadow:0 0 0 3px rgba(63,217,205,0.18);
  }
  .search-tab input::placeholder{color:#7f9391;}
  .search-tab svg{
    position:absolute;
    left:11px;
    top:50%;
    transform:translateY(-50%);
    width:15px;
    height:15px;
    stroke:var(--ink-soft);
    pointer-events:none;
  }
  select#brand-filter{
    padding:10px 32px 10px 14px;
    border:1px solid var(--line);
    border-radius:10px;
    background:var(--card);
    font-family:"Inter", sans-serif;
    font-size:14px;
    color:var(--ink);
    outline:none;
    cursor:pointer;
    appearance:none;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%23a9b8b6' stroke-width='2'><polyline points='6 9 12 15 18 9'/></svg>");
    background-repeat:no-repeat;
    background-position:right 10px center;
  }
  select#brand-filter:focus{
    border-color:var(--briar);
    box-shadow:0 0 0 3px rgba(63,217,205,0.18);
  }
  .result-count{
    font-family:var(--mono);
    font-size:12px;
    color:var(--ink-soft);
    white-space:nowrap;
  }

  /* ---------- Layout ---------- */
  .wrap{
    max-width:1120px;
    margin:0 auto;
    padding:36px 24px 100px;
  }
  .brand-section{margin-bottom:46px;}
  .brand-section.is-hidden{display:none;}
  .brand-header{
    display:flex;
    align-items:baseline;
    gap:14px;
    margin-bottom:18px;
    padding-bottom:10px;
    border-bottom:1px solid var(--line);
  }
  .brand-header.no-name{border-bottom-color:rgba(127,154,156,0.35);}
  .brand-header.other-makers{border-bottom-color:rgba(159,195,206,0.35);}
  .brand-header.other-makers h2.brand-name{color:var(--brass);}
  .card-brand-tag{
    font-family:var(--mono);
    font-size:9.5px;
    letter-spacing:0.05em;
    text-transform:uppercase;
    color:var(--brass);
  }
  h2.brand-name{
    font-family:"Inter", sans-serif;
    font-weight:600;
    font-size:24px;
    margin:0;
    letter-spacing:-0.01em;
  }
  .brand-header.no-name h2.brand-name{color:var(--sage);}
  .brand-count{
    font-family:var(--mono);
    font-size:12px;
    color:var(--brass);
    background:rgba(159,195,206,0.14);
    padding:3px 9px;
    border-radius:20px;
  }
  .grid{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(190px, 220px));
    justify-content:start;
    gap:16px;
  }
  .card{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:14px;
    overflow:hidden;
    box-shadow:var(--shadow);
    text-decoration:none;
    display:flex;
    flex-direction:column;
    transition:transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .card:hover{
    transform:translateY(-3px);
    box-shadow:0 4px 8px rgba(0,0,0,0.35), 0 14px 28px rgba(0,0,0,0.4);
    border-color:rgba(63,217,205,0.35);
  }
  .card:focus-visible{
    outline:2px solid var(--briar);
    outline-offset:2px;
  }
  .card-img{
    aspect-ratio:4/3;
    background:
      linear-gradient(180deg, rgba(0,0,0,0.15), rgba(0,0,0,0.0) 40%),
      var(--paper-deep);
    display:flex;
    align-items:center;
    justify-content:center;
    position:relative;
  }
  .card-img img{
    width:100%;
    height:100%;
    object-fit:contain;
    padding:10px;
  }
  .no-image{
    font-family:var(--mono);
    font-size:11px;
    color:#7f9391;
    letter-spacing:0.05em;
    text-align:center;
    padding:0 12px;
  }
  .no-image svg{
    width:26px;
    height:26px;
    stroke:#6a8280;
    margin-bottom:6px;
  }
  .card-body{
    padding:12px 13px 14px;
    display:flex;
    flex-direction:column;
    gap:8px;
    flex:1;
  }
  .card-model{
    font-family:"Inter", sans-serif;
    font-weight:500;
    font-size:15px;
    line-height:1.25;
    color:var(--ink);
  }
  .card-id{
    align-self:flex-start;
    font-family:var(--mono);
    font-size:10.5px;
    letter-spacing:0.03em;
    color:var(--briar-deep);
    background:rgba(63,217,205,0.08);
    border:1px solid rgba(63,217,205,0.20);
    padding:2px 7px;
    border-radius:8px;
    box-shadow:inset 0 1px 1px rgba(255,255,255,0.06), inset 0 -1px 1px rgba(0,0,0,0.25);
  }
  .ratings{
    display:flex;
    gap:10px;
    margin-top:auto;
    padding-top:8px;
    border-top:1px dashed var(--line);
  }
  .rating{
    display:flex;
    flex-direction:column;
    gap:2px;
    align-items:flex-start;
  }
  .rating-label{
    font-size:9px;
    text-transform:uppercase;
    letter-spacing:0.06em;
    color:#8ea3a1;
  }
  .rating-value{
    font-family:var(--mono);
    font-size:12px;
    font-weight:500;
    color:var(--ink);
  }
  .rating-value.high{color:var(--briar);}
  .rating-value.low{color:var(--sage);opacity:0.75;}
  .empty-state{
    text-align:center;
    padding:80px 20px;
    color:var(--ink-soft);
  }
  .empty-state.is-hidden{display:none;}
  .empty-state svg{
    width:36px;
    height:36px;
    stroke:#6a8280;
    margin-bottom:14px;
  }
  .empty-state p{
    font-family:"Inter", sans-serif;
    font-size:18px;
    margin:0 0 6px;
  }
  .empty-state span{
    font-size:14px;
    color:#7f9391;
  }
  footer{
    text-align:center;
    padding:30px 24px 50px;
    font-family:var(--mono);
    font-size:11px;
    color:#7f9391;
    letter-spacing:0.03em;
  }
  @media (prefers-reduced-motion: reduce){
    *{transition:none !important; scroll-behavior:auto !important;}
  }
  @media (max-width:480px){
    .masthead{padding:48px 18px 32px;}
    .grid{grid-template-columns:repeat(auto-fill, minmax(150px, 1fr));gap:12px;}
    .index-inner{gap:10px;}
  }
</style>
</head>
<body>

<header class="masthead">
  <p class="eyebrow">08 Pipes &middot; Catalogue</p>
  <h1 class="title">The Pipe Gallery</h1>
  <p class="subtitle">Every estate pipe in the collection, stamped, sorted, and cross-referenced to its full note. Click through for condition, history, and the episode it featured in.</p>
  <div class="stats-row">
    <div class="stat"><b id="stat-total">0</b> pipes</div>
    <div class="stat"><b id="stat-brands">0</b> makers</div>
    <div class="stat"><b id="stat-images">0</b> photographed</div>
  </div>
</header>

<div class="index-bar">
  <div class="index-inner">
    <div class="search-tab">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="search-input" placeholder="Search by brand, model, or stamp ID&hellip;" autocomplete="off">
    </div>
    <select id="brand-filter">
      <option value="">All makers</option>
    </select>
    <span class="result-count" id="result-count"></span>
  </div>
</div>

<main class="wrap" id="gallery-root"></main>

<div class="empty-state is-hidden" id="empty-state">
  <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
  <p>No pipes match that search</p>
  <span>Try a different brand or stamp number</span>
</div>

<footer>08 Pipes &mdash; an ongoing estate pipe catalogue</footer>

<script>
const PIPES = [];

function esc(s){
  if (s === null || s === undefined) return "";
  return String(s).replace(/[&<>"']/g, c => ({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  }[c]));
}

function ratingClass(v){
  const n = parseInt(v, 10);
  if (isNaN(n)) return "";
  if (n >= 8) return "high";
  if (n <= 3) return "low";
  return "";
}

const MIN_BRAND_SIZE = 3;
const OTHER_LABEL = "Other Makers";

function groupByBrand(pipes){
  const counts = new Map();
  pipes.forEach(p => {
    const brand = (p.brand && p.brand.trim()) ? p.brand.trim() : "No Name";
    const key = brand === "Unknown" ? "No Name" : brand;
    counts.set(key, (counts.get(key) || 0) + 1);
  });

  const map = new Map();
  pipes.forEach(p => {
    let brand = (p.brand && p.brand.trim()) ? p.brand.trim() : "No Name";
    brand = brand === "Unknown" ? "No Name" : brand;
    const sectionKey = (brand !== "No Name" && counts.get(brand) < MIN_BRAND_SIZE) ? OTHER_LABEL : brand;
    if (!map.has(sectionKey)) map.set(sectionKey, []);
    map.get(sectionKey).push(p);
  });

  map.forEach((list, key) => {
    if (key === OTHER_LABEL) {
      list.sort((a,b) => {
        const byBrand = (a.brand||"").localeCompare(b.brand||"");
        return byBrand !== 0 ? byBrand : (a.model||"").localeCompare(b.model||"");
      });
    } else {
      list.sort((a,b) => (a.model||"").localeCompare(b.model||""));
    }
  });

  const keys = Array.from(map.keys()).sort((a,b) => {
    if (a === "No Name") return 1;
    if (b === "No Name") return -1;
    if (a === OTHER_LABEL) return 1;
    if (b === OTHER_LABEL) return -1;
    return a.localeCompare(b);
  });

  return { map, keys };
}

function cardHTML(p, showBrandTag){
  const modelLabel = p.model ? esc(p.model) : esc(p.id || "Unknown");
  const imgBlock = p.image
    ? `<img src="${esc(p.image)}" alt="${esc(p.brand)} ${esc(p.model)}" loading="lazy">`
    : `<div class="no-image">
         <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
         <div>No photo yet</div>
       </div>`;
  const brandTag = showBrandTag ? `<div class="card-brand-tag">${esc(p.brand)}</div>` : "";

  return `
  <a class="card" href="${esc(p.permalink)}" data-brand="${esc(p.brand)}" data-search="${esc((p.brand+' '+p.model+' '+p.id).toLowerCase())}">
    <div class="card-img">${imgBlock}</div>
    <div class="card-body">
      ${brandTag}
      <div class="card-model">${modelLabel}</div>
      <div class="card-id">${esc(p.id)}</div>
      <div class="ratings">
        <div class="rating">
          <span class="rating-label">Cond</span>
          <span class="rating-value ${ratingClass(p.condition)}">${esc(p.condition ?? "&mdash;")}</span>
        </div>
        <div class="rating">
          <span class="rating-label">Pref</span>
          <span class="rating-value ${ratingClass(p.preference)}">${esc(p.preference ?? "&mdash;")}</span>
        </div>
        <div class="rating">
          <span class="rating-label">Pop</span>
          <span class="rating-value ${ratingClass(p.popularity)}">${esc(p.popularity ?? "&mdash;")}</span>
        </div>
      </div>
    </div>
  </a>`;
}

function render(){
  const { map, keys } = groupByBrand(PIPES);
  const root = document.getElementById("gallery-root");
  const brandSelect = document.getElementById("brand-filter");

  const brandCounts = new Map();
  PIPES.forEach(p => {
    let b = (p.brand && p.brand.trim()) ? p.brand.trim() : "No Name";
    b = b === "Unknown" ? "No Name" : b;
    brandCounts.set(b, (brandCounts.get(b) || 0) + 1);
  });
  const brandKeys = Array.from(brandCounts.keys()).sort((a,b) => {
    if (a === "No Name") return 1;
    if (b === "No Name") return -1;
    return a.localeCompare(b);
  });
  brandKeys.forEach(k => {
    const opt = document.createElement("option");
    opt.value = k;
    opt.textContent = `${k} (${brandCounts.get(k)})`;
    brandSelect.appendChild(opt);
  });

  document.getElementById("stat-total").textContent = PIPES.length;
  document.getElementById("stat-brands").textContent = brandKeys.filter(k => k !== "No Name").length;
  document.getElementById("stat-images").textContent = PIPES.filter(p => p.image).length;

  let html = "";
  keys.forEach(sectionKey => {
    const pipes = map.get(sectionKey);
    const isNoName = sectionKey === "No Name";
    const isOther = sectionKey === OTHER_LABEL;
    html += `
    <section class="brand-section" data-brand-section="${esc(sectionKey)}">
      <div class="brand-header ${isNoName ? "no-name" : ""} ${isOther ? "other-makers" : ""}">
        <h2 class="brand-name">${esc(sectionKey)}</h2>
        <span class="brand-count">${pipes.length}</span>
      </div>
      <div class="grid">
        ${pipes.map(p => cardHTML(p, isOther)).join("")}
      </div>
    </section>`;
  });
  root.innerHTML = html;

  attachFilterLogic();
}

function attachFilterLogic(){
  const searchInput = document.getElementById("search-input");
  const brandSelect = document.getElementById("brand-filter");
  const resultCount = document.getElementById("result-count");
  const emptyState = document.getElementById("empty-state");
  const cards = Array.from(document.querySelectorAll(".card"));
  const sections = Array.from(document.querySelectorAll(".brand-section"));

  function applyFilters(){
    const q = searchInput.value.trim().toLowerCase();
    const brand = brandSelect.value;
    let visibleCount = 0;

    cards.forEach(card => {
      const matchesQuery = !q || card.dataset.search.includes(q);
      const matchesBrand = !brand || (card.dataset.brand === brand) || (brand === "No Name" && (!card.dataset.brand || card.dataset.brand === "Unknown" || card.dataset.brand === ""));
      const visible = matchesQuery && matchesBrand;
      card.style.display = visible ? "" : "none";
      if (visible) visibleCount++;
    });

    sections.forEach(sec => {
      const anyVisible = Array.from(sec.querySelectorAll(".card")).some(c => c.style.display !== "none");
      sec.classList.toggle("is-hidden", !anyVisible);
    });

    resultCount.textContent = (q || brand) ? `${visibleCount} of ${cards.length}` : "";
    emptyState.classList.toggle("is-hidden", visibleCount !== 0);
  }

  searchInput.addEventListener("input", applyFilters);
  brandSelect.addEventListener("change", applyFilters);
}

render();
</script>

</body>
</html>
